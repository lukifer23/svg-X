{
  "name": "svg-x",
  "private": true,
  "type": "module",
  "version": "1.4.0",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=12.0.0 <13"
  },
  "volta": {
    "node": "24.19.0",
    "npm": "12.0.2"
  },
  "main": "main.cjs",
  "description": "Local-first B&W, color-region, and centerline vectorizer with SVG, EPS, DXF, and JSON export",
  "homepage": "https://github.com/lukifer23/svg-X",
  "desktopName": "svg-x.desktop",
  "author": "Luke S",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config vitest.config.ts",
    "test:bench": "vitest run --config vitest.config.ts src/utils/imageProcessor.bench.test.ts",
    "bench:pipeline": "vitest run --config benchmarks/vitest.config.ts benchmarks/pipeline.test.ts",
    "bench:photo": "vitest run --config benchmarks/vitest.config.ts benchmarks/photoColor.test.ts",
    "bench:competitive": "vitest run --config benchmarks/vitest.config.ts benchmarks/competitiveColor.test.ts",
    "bench:preview": "npm run build && cross-env SVGX_PREVIEW_BENCHMARK=1 playwright test e2e/web/previewLatency.spec.ts --project=chromium --workers=1 --retries=0",
    "bench:centerline": "vitest run --config benchmarks/vitest.config.ts benchmarks/centerline.test.ts",
    "bench:scan-lighting": "vitest run --config benchmarks/vitest.config.ts benchmarks/scanLighting.test.ts",
    "test:archival": "vitest run --config benchmarks/vitest.config.ts benchmarks/archivalQualification.test.ts",
    "test:restoration": "vitest run --config benchmarks/vitest.config.ts benchmarks/scanRestoration.test.ts",
    "test:restoration:spans": "vitest run --config benchmarks/vitest.config.ts benchmarks/scanRestorationSpans.test.ts",
    "restoration:pilot": "node scripts/run-restoration-pilot.mjs",
    "test:export-consumers": "cross-env SVGX_EXPORT_CONSUMERS=1 vitest run --config benchmarks/vitest.config.ts benchmarks/exportConsumers.test.ts",
    "dataset:build": "node scripts/build-training-dataset.mjs",
    "dataset:audit": "node scripts/audit-training-dataset.mjs",
    "test:e2e:web": "npm run test:e2e:web:functional && npm run test:e2e:performance",
    "test:e2e:web:functional": "playwright test --grep-invert \"production worker batch\"",
    "test:e2e:performance": "playwright test e2e/web/performance.spec.ts --project=chromium --workers=1 --retries=0",
    "test:e2e:package": "node scripts/run-packaged-e2e.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "audit:deps": "cross-env npm_config_allow_scripts= npm audit --audit-level=moderate",
    "ci:check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run verify:assets && npm run build && npm run audit:deps",
    "preview": "vite preview",
    "electron:dev": "node scripts/dev-electron.mjs",
    "electron:direct": "electron .",
    "electron:build": "vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder build --publish never",
    "package:dir": "vite build && electron-builder --dir --publish never",
    "package:portable": "vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win portable --x64 --publish never"
  },
  "dependencies": {
    "@cadit-app/potrace-ts": "1.3.0",
    "express": "5.3.0",
    "lucide-react": "1.77.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "slugify": "1.6.9",
    "svgo": "4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "cross-env": "10.1.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wait-on": "9.5.1"
  },
  "build": {
    "appId": "com.svg-x.app",
    "productName": "SVG-X",
    "files": [
      "dist/**/*",
      "main.cjs",
      "preload.cjs",
      "desktop/**/*",
      "assets/icon.png",
      "icon.svg",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sharp/**/*",
      "**/node_modules/@img/**/*"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "verifyUpdateCodeSignature": false,
      "signAndEditExecutable": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "syncDesktopName": true,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "deb": {
      "maintainer": "SVG-X <56565060+lukifer23@users.noreply.github.com>"
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  },
  "overrides": {
    "app-builder-lib@26.18.0": {
      "minimatch": "11.0.9",
      "@electron/universal": {
        "minimatch": "11.0.9"
      }
    }
  }
}
